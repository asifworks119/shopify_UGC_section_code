<div class="cugc-section">
  {% if section.settings.heading != blank %}
    <h2 class="cugc-heading">{{ section.settings.heading }}</h2>
  {% endif %}

  <div class="cugc-carousel-wrapper">
    <div class="cugc-carousel">
      {% for block in section.blocks %}
        <div class="cugc-item" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <div class="cugc-video-container">
            <video 
              class="cugc-video" 
              loop 
              muted 
              playsinline
              preload="metadata"
            >
              {% if block.settings.video %}
                {% for source in block.settings.video.sources %}
                  <source src="{{ source.url }}" type="{{ source.mime_type }}">
                {% endfor %}
              {% endif %}
            </video>
            
            {% if forloop.index0 == 0 %}
              <button class="cugc-mute-toggle" aria-label="Toggle sound">
                <svg class="cugc-mute-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/>
                </svg>
                <svg class="cugc-unmute-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style="display: none;">
                  <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
                </svg>
              </button>
            {% endif %}
          </div>

          {% if block.settings.product != blank %}
            {% assign product = block.settings.product %}
            <div class="cugc-product">
              <a href="{{ product.url }}" class="cugc-product-link">
                <img src="{{ product.featured_image | img_url: '80x80' }}" alt="{{ product.title }}" class="cugc-product-image" loading="lazy">
                <div class="cugc-product-info">
                  <h3 class="cugc-product-title">{{ product.title }}</h3>
                  <p class="cugc-product-price">{{ product.price | money }}</p>
                </div>
                <button class="cugc-product-btn" aria-label="View product">+</button>
              </a>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>

  <div class="cugc-controls">
    <button class="cugc-control-btn cugc-control-prev" aria-label="Previous">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>
    <button class="cugc-control-btn cugc-control-next" aria-label="Next">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  </div>
</div>

<script>
(function() {
  const section = document.querySelector('.cugc-section');
  if (!section) return;
  
  const carousel = section.querySelector('.cugc-carousel');
  const items = Array.from(section.querySelectorAll('.cugc-item'));
  const controlPrev = section.querySelector('.cugc-control-prev');
  const controlNext = section.querySelector('.cugc-control-next');
  const muteToggle = section.querySelector('.cugc-mute-toggle');
  
  if (items.length === 0) return;
  
  let currentIndex = 0;
  let isMuted = true;
  let isTransitioning = false;
  let isDragging = false;
  let startX = 0;
  let startY = 0;
  let currentX = 0;
  let currentY = 0;
  let dragDirection = null;
  const totalItems = items.length;

  // Create continuous loop by cloning items
  function createLoop() {
    // Clone first 2 items and append to end
    for (let i = 0; i < Math.min(2, totalItems); i++) {
      const clone = items[i].cloneNode(true);
      clone.classList.add('cugc-clone');
      clone.setAttribute('data-clone-of', i);
      carousel.appendChild(clone);
    }
    
    // Clone last 2 items and prepend to start
    for (let i = Math.max(totalItems - 2, 0); i < totalItems; i++) {
      const clone = items[i].cloneNode(true);
      clone.classList.add('cugc-clone');
      clone.setAttribute('data-clone-of', i);
      carousel.insertBefore(clone, carousel.firstChild);
    }
  }

  function getVisibleItems() {
    return Array.from(carousel.querySelectorAll('.cugc-item'));
  }

  function updateCarousel(animate = true) {
    const allItems = getVisibleItems();
    const offset = Math.min(2, totalItems); // Offset for prepended clones
    const centerIndex = currentIndex + offset;

    allItems.forEach((item, index) => {
      const position = index - centerIndex;
      const videoContainer = item.querySelector('.cugc-video-container');
      let zIndex;
      
      // Center item - taller
      if (position === 0) {
        videoContainer.style.height = '500px';
        zIndex = 10;
        item.style.opacity = '1';
        item.style.pointerEvents = 'auto';
      }
      // Side items - square/shorter
      else if (Math.abs(position) === 1) {
        videoContainer.style.height = '380px';
        zIndex = 5;
        item.style.opacity = '0.9';
        item.style.pointerEvents = 'auto';
      }
      else {
        videoContainer.style.height = '380px';
        zIndex = 3;
        item.style.opacity = '0.9';
        item.style.pointerEvents = 'auto';
      }
      
      const translateX = position * 300;
      
      item.style.transform = `translateX(${translateX}px)`;
      item.style.zIndex = zIndex;
      item.style.transition = animate ? 'all 0.6s cubic-bezier(0.4, 0, 0.2, 1)' : 'none';
      videoContainer.style.transition = animate ? 'height 0.6s cubic-bezier(0.4, 0, 0.2, 1)' : 'none';
    });

    // Play only center video
    const allVideos = Array.from(carousel.querySelectorAll('.cugc-video'));
    allVideos.forEach((video, index) => {
      if (index === centerIndex) {
        video.muted = isMuted;
        video.play().catch(e => console.log('Play prevented:', e));
      } else {
        video.pause();
        video.muted = true;
        video.currentTime = 0;
      }
    });

    // Move mute button to center video
    if (muteToggle) {
      const centerItem = allItems[centerIndex];
      const videoContainer = centerItem.querySelector('.cugc-video-container');
      if (videoContainer && !videoContainer.querySelector('.cugc-mute-toggle')) {
        videoContainer.appendChild(muteToggle);
      }
    }
  }

  function toggleMute(e) {
    e.stopPropagation();
    e.preventDefault();
    isMuted = !isMuted;
    const allVideos = Array.from(carousel.querySelectorAll('.cugc-video'));
    const offset = Math.min(2, totalItems);
    const centerIndex = currentIndex + offset;
    const currentVideo = allVideos[centerIndex];
    
    if (currentVideo) {
      currentVideo.muted = isMuted;
    }
    
    if (muteToggle) {
      const muteIcon = muteToggle.querySelector('.cugc-mute-icon');
      const unmuteIcon = muteToggle.querySelector('.cugc-unmute-icon');
      
      if (isMuted) {
        muteIcon.style.display = 'block';
        unmuteIcon.style.display = 'none';
      } else {
        muteIcon.style.display = 'none';
        unmuteIcon.style.display = 'block';
      }
    }
  }

  function nextSlide() {
    if (isTransitioning) return;
    isTransitioning = true;
    
    currentIndex++;
    updateCarousel(true);
    
    // Check if we need to loop back
    if (currentIndex >= totalItems) {
      setTimeout(() => {
        currentIndex = 0;
        updateCarousel(false);
        setTimeout(() => {
          isTransitioning = false;
        }, 50);
      }, 600);
    } else {
      setTimeout(() => {
        isTransitioning = false;
      }, 600);
    }
  }

  function prevSlide() {
    if (isTransitioning) return;
    isTransitioning = true;
    
    currentIndex--;
    updateCarousel(true);
    
    // Check if we need to loop forward
    if (currentIndex < 0) {
      setTimeout(() => {
        currentIndex = totalItems - 1;
        updateCarousel(false);
        setTimeout(() => {
          isTransitioning = false;
        }, 50);
      }, 600);
    } else {
      setTimeout(() => {
        isTransitioning = false;
      }, 600);
    }
  }

  // Event listeners for control buttons
  if (controlPrev) {
    controlPrev.addEventListener('click', (e) => {
      e.preventDefault();
      prevSlide();
    });
  }
  
  if (controlNext) {
    controlNext.addEventListener('click', (e) => {
      e.preventDefault();
      nextSlide();
    });
  }

  if (muteToggle) {
    muteToggle.addEventListener('click', toggleMute);
  }

  // Click on items to center them
  function setupItemClicks() {
    const allItems = getVisibleItems();
    allItems.forEach((item) => {
      item.addEventListener('click', (e) => {
        // Don't trigger if clicking on product link or mute button
        if (e.target.closest('.cugc-product-link') || e.target.closest('.cugc-mute-toggle')) {
          return;
        }
        
        const dataIndex = item.getAttribute('data-index');
        const cloneOf = item.getAttribute('data-clone-of');
        const targetIndex = cloneOf !== null ? parseInt(cloneOf) : parseInt(dataIndex);
        
        if (targetIndex !== currentIndex && !isNaN(targetIndex)) {
          const diff = targetIndex - currentIndex;
          const absDiff = Math.abs(diff);
          
          // Choose shortest path
          let steps = diff;
          if (absDiff > totalItems / 2) {
            steps = diff > 0 ? diff - totalItems : diff + totalItems;
          }
          
          if (steps > 0) {
            for (let i = 0; i < steps; i++) {
              setTimeout(() => nextSlide(), i * 650);
            }
          } else if (steps < 0) {
            for (let i = 0; i < Math.abs(steps); i++) {
              setTimeout(() => prevSlide(), i * 650);
            }
          }
        }
      });
    });
  }

  // Touch/Mouse drag with improved mobile scroll detection
  function handleDragStart(e) {
    if (e.target.closest('.cugc-product-link') || e.target.closest('.cugc-mute-toggle')) return;
    
    startX = e.type === 'mousedown' ? e.pageX : e.touches[0].pageX;
    startY = e.type === 'mousedown' ? e.pageY : e.touches[0].pageY;
    currentX = startX;
    currentY = startY;
    dragDirection = null;
    isDragging = false; // Don't set to true yet, wait to detect direction
    
    if (e.type === 'mousedown') {
      carousel.style.cursor = 'grabbing';
    }
  }

  function handleDragMove(e) {
    if (dragDirection === 'vertical') return; // Allow vertical scroll
    
    const moveX = e.type === 'mousemove' ? e.pageX : e.touches[0].pageX;
    const moveY = e.type === 'mousemove' ? e.pageY : e.touches[0].pageY;
    
    // If direction hasn't been determined yet
    if (!dragDirection && (startX !== null && startY !== null)) {
      const diffX = Math.abs(moveX - startX);
      const diffY = Math.abs(moveY - startY);
      
      // Determine direction after 10px movement
      if (diffX > 10 || diffY > 10) {
        if (diffY > diffX) {
          // Vertical scroll - allow default behavior
          dragDirection = 'vertical';
          return;
        } else {
          // Horizontal drag - start carousel drag
          dragDirection = 'horizontal';
          isDragging = true;
        }
      }
    }
    
    // Only prevent default and update position for horizontal drags
    if (dragDirection === 'horizontal' && isDragging) {
      e.preventDefault();
      currentX = moveX;
      currentY = moveY;
    }
  }

  function handleDragEnd(e) {
    if (dragDirection === 'vertical') {
      // Reset for next interaction
      dragDirection = null;
      startX = null;
      startY = null;
      return;
    }
    
    if (!isDragging) {
      dragDirection = null;
      startX = null;
      startY = null;
      return;
    }
    
    isDragging = false;
    dragDirection = null;
    carousel.style.cursor = 'grab';
    
    const diff = startX - currentX;
    if (Math.abs(diff) > 50) {
      if (diff > 0) {
        nextSlide();
      } else {
        prevSlide();
      }
    }
    
    startX = null;
    startY = null;
  }

  carousel.addEventListener('mousedown', handleDragStart);
  carousel.addEventListener('touchstart', handleDragStart, { passive: true });
  document.addEventListener('mousemove', handleDragMove);
  document.addEventListener('touchmove', handleDragMove, { passive: false });
  document.addEventListener('mouseup', handleDragEnd);
  document.addEventListener('touchend', handleDragEnd);

  // Keyboard navigation
  document.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') {
      e.preventDefault();
      prevSlide();
    }
    if (e.key === 'ArrowRight') {
      e.preventDefault();
      nextSlide();
    }
  });

  // Initialize
  createLoop();
  updateCarousel(false);
  setupItemClicks();
  
  // Autoplay center video
  setTimeout(() => {
    const allVideos = Array.from(carousel.querySelectorAll('.cugc-video'));
    const offset = Math.min(2, totalItems);
    if (allVideos[offset]) {
      allVideos[offset].muted = true;
      allVideos[offset].play().catch(e => console.log('Autoplay prevented:', e));
    }
  }, 100);
})();
</script>

